
profile single {
    output "eDP-1" {
        mode 1920x1080
        position 0,0
        scale 1.25
    }
}

profile dual {
    output "eDP-1" {
        mode 1920x1080
        position 0,0
        scale 1.25
    }
    
    output "HDMI-A-1" {
        mode "1920x1200"
        scale 1.0
        transform "normal"
        position -1920,0
    }
}
